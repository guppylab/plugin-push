{
    "name": "guppylab/plugin-push",
    "description": "Push notifications for NativePHP Mobile: direct APNs (.p8, no Firebase) on iOS and Firebase Cloud Messaging on Android, with payload delivery, notification taps, unenrolment and the badge",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "mobile",
        "push",
        "apns",
        "fcm",
        "notifications",
        "remote"
    ],
    "authors": [
        {
            "name": "Guppylab",
            "email": "edison.filho@keepcloud.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Guppylab\\Push\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guppylab\\Push\\PushNotificationServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.32"
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
