{
    "name": "guppylab/plugin-push",
    "version": "3.0.0",
    "description": "Push notifications via direct APNs (.p8) on iOS and Firebase Cloud Messaging on Android — native handlers for the NativePHP Mobile PushNotifications facade, plus payload delivery, notification taps, unenrolment and the badge",
    "namespace": "PushNotification",
    "keywords": ["push", "apns", "fcm", "notifications", "remote"],
    "category": "notifications",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "Guppylab",
        "email": "edison.filho@keepcloud.io",
        "url": "https://github.com/guppylab"
    },
    "homepage": "https://github.com/guppylab/plugin-push",
    "repository": "https://github.com/guppylab/plugin-push",
    "funding": [],
    "platforms": [
        "ios",
        "android"
    ],
    "screenshots": [],
    "bridge_functions": [
        {
            "name": "PushNotification.RequestPermission",
            "ios": "PushNotificationFunctions.RequestPermission",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.RequestPermission",
            "android_params": ["activity"],
            "description": "Asks for the notification permission and enrols the device (APNs on iOS, FCM on Android); the token arrives on the TokenGenerated event"
        },
        {
            "name": "PushNotification.CheckPermission",
            "ios": "PushNotificationFunctions.CheckPermission",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.CheckPermission",
            "android_params": ["activity"],
            "description": "Returns the current notification permission state"
        },
        {
            "name": "PushNotification.GetToken",
            "ios": "PushNotificationFunctions.GetToken",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.GetToken",
            "android_params": ["context"],
            "description": "Returns the last device token received (APNs hex on iOS, FCM on Android), or null"
        },
        {
            "name": "PushNotification.Configure",
            "ios": "PushNotificationFunctions.Configure",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.Configure",
            "android_params": ["context"],
            "description": "Hands the app's push settings (channel, icon, event classes) to the native side"
        },
        {
            "name": "PushNotification.Unenroll",
            "ios": "PushNotificationFunctions.Unenroll",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.Unenroll",
            "android_params": ["context"],
            "description": "Deletes the device token and stops receiving pushes — the logout call"
        },
        {
            "name": "PushNotification.SetBadge",
            "ios": "PushNotificationFunctions.SetBadge",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.SetBadge",
            "android_params": ["context"],
            "description": "Sets the app icon badge count (iOS only; reports platform android as unsupported)"
        },
        {
            "name": "PushNotification.IsSupported",
            "ios": "PushNotificationFunctions.IsSupported",
            "android": "com.guppylab.plugins.push.PushNotificationFunctions.IsSupported",
            "android_params": ["context"],
            "description": "Whether push can work on this device (real device on iOS, google-services.json present on Android)"
        }
    ],
    "android": {
        "min_version": 21,
        "init_function": "com.guppylab.plugins.push.initGuppylabPush",
        "permissions": [
            "android.permission.POST_NOTIFICATIONS"
        ],
        "repositories": [],
        "dependencies": {
            "implementation": [
                "com.google.firebase:firebase-messaging:24.1.0"
            ]
        },
        "activities": [],
        "services": [
            {
                "name": "com.guppylab.plugins.push.PushMessagingService",
                "exported": false,
                "intent_filters": [
                    {
                        "action": "com.google.firebase.MESSAGING_EVENT"
                    }
                ]
            }
        ],
        "receivers": [],
        "providers": []
    },
    "ios": {
        "min_version": "15.0",
        "init_function": "initGuppylabPush",
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "swift_packages": [],
            "pods": []
        },
        "entitlements": {
            "aps-environment": "production"
        }
    },
    "assets": {
        "android": [],
        "ios": []
    },
    "secrets": [],
    "events": [
        "Guppylab\\Push\\Events\\MessageReceived",
        "Guppylab\\Push\\Events\\NotificationTapped"
    ],
    "service_provider": "Guppylab\\Push\\PushNotificationServiceProvider",
    "hooks": {}
}
